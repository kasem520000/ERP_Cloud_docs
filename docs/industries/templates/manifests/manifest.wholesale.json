{
  "id": "industry.wholesale",
  "name": "Wholesale & Trade",
  "name_ar": "الجملة والتجارة",
  "version": "1.0.0",
  "required_feature_keys": [
    "industry.template_engine",
    "items.barcodes",
    "items.price_lists",
    "partners.credit_terms",
    "partners.statements",
    "sales.quotations",
    "sales.orders",
    "sales.deliveries",
    "sales.invoices",
    "sales.credit_limits",
    "purchasing.goods_receipts",
    "inventory.multi_warehouse",
    "notes.received"
  ],
  "default_modules_enabled": [
    "accounting",
    "partners",
    "items",
    "inventory",
    "sales",
    "purchasing",
    "treasury",
    "tax",
    "reporting",
    "notes",
    "configuration"
  ],
  "terminology_overrides": {
    "partner.customer": {
      "en": "Customer (trader)",
      "ar": "العميل / التاجر"
    },
    "doc.sales_invoice": {
      "en": "Wholesale sales invoice",
      "ar": "فاتورة بيع جملة"
    },
    "doc.quotation": {
      "en": "Trade quote",
      "ar": "عرض السعر"
    },
    "doc.sales_order": {
      "en": "Bulk order",
      "ar": "أمر التوريد"
    },
    "billing.receipt_voucher": {
      "en": "Receipt voucher",
      "ar": "سند قبض"
    },
    "price.qty_break": {
      "en": "Quantity break",
      "ar": "شريحة الكمية"
    },
    "price.min_qty": {
      "en": "Min. quantity",
      "ar": "الحد الأدنى للكمية"
    },
    "price.customer_tier": {
      "en": "Customer price tier",
      "ar": "فئة سعر العميل"
    },
    "credit.limit": {
      "en": "Credit limit",
      "ar": "سقف الائتمان"
    },
    "credit.terms": {
      "en": "Credit terms",
      "ar": "شروط الدفع"
    },
    "notes.pdc": {
      "en": "Post-dated note",
      "ar": "شيك مؤجل"
    },
    "billing.statement": {
      "en": "Customer statement",
      "ar": "كشف حساب العميل"
    }
  },
  "navigation_manifest": {
    "groups": [
      {
        "id": "trading",
        "label": {
          "en": "Trading",
          "ar": "التجارة"
        },
        "order": 1,
        "items": [
          {
            "id": "quick_order",
            "label": {
              "en": "Bulk quick order",
              "ar": "إدخال طلب سريع"
            },
            "target": "sales.quick_order"
          },
          {
            "id": "quotes",
            "label": {
              "en": "Quotes",
              "ar": "عروض الأسعار"
            },
            "target": "sales.quotations"
          },
          {
            "id": "orders",
            "label": {
              "en": "Bulk orders",
              "ar": "أوامر التوريد"
            },
            "target": "sales.orders"
          },
          {
            "id": "deliveries",
            "label": {
              "en": "Deliveries",
              "ar": "إشعارات التسليم"
            },
            "target": "sales.deliveries"
          }
        ]
      },
      {
        "id": "credit",
        "label": {
          "en": "Credit & collections",
          "ar": "الائتمان والتحصيل"
        },
        "order": 2,
        "items": [
          {
            "id": "invoices",
            "label": {
              "en": "Credit invoices",
              "ar": "فواتير الآجل"
            },
            "target": "sales.invoices"
          },
          {
            "id": "statements",
            "label": {
              "en": "Customer statements",
              "ar": "كشوف الحسابات"
            },
            "target": "partners.statements"
          },
          {
            "id": "pdc",
            "label": {
              "en": "PDC custody",
              "ar": "الشيكات المؤجلة"
            },
            "target": "notes.received",
            "feature_key": "notes.received"
          },
          {
            "id": "maturity",
            "label": {
              "en": "Maturity calendar",
              "ar": "تقويم الاستحقاق"
            },
            "target": "notes.pdc_calendar",
            "feature_key": "notes.pdc_calendar"
          }
        ]
      }
    ]
  },
  "workflow_policies": {
    "credit_sale_credit_limit_enforced": true,
    "qty_break_pricing_automatic": true,
    "tier_price_automatic_by_partner": true,
    "bulk_order_from_quote_one_click": true,
    "delivery_before_credit_invoice": true,
    "statement_monthly_by_default": true,
    "pdc_note_requires_maturity_date": true
  },
  "document_numbering_defaults": {
    "quotation": {
      "prefix": "QT",
      "format": "QT-{yyyy}-{seq:5}",
      "per_branch": false,
      "reserve_on_approval": false
    },
    "sales_order": {
      "prefix": "ORD",
      "format": "ORD-{yyyy}-{seq:6}",
      "per_branch": false,
      "reserve_on_approval": true
    },
    "delivery_note": {
      "prefix": "DLV",
      "format": "DLV-{yyyy}-{seq:5}",
      "per_branch": false,
      "reserve_on_approval": false
    },
    "sales_invoice": {
      "prefix": "INV",
      "format": "INV-{yyyy}-{seq:6}",
      "per_branch": false,
      "reserve_on_approval": false
    },
    "credit_note": {
      "prefix": "CN",
      "format": "CN-{yyyy}-{seq:5}",
      "per_branch": false,
      "reserve_on_approval": false
    },
    "receipt": {
      "prefix": "RCP",
      "format": "RCP-{yyyy}-{seq:6}",
      "per_branch": false,
      "reserve_on_approval": false
    },
    "goods_receipt": {
      "prefix": "GRN",
      "format": "GRN-{yyyy}-{seq:6}",
      "per_branch": false,
      "reserve_on_approval": false
    },
    "stock_transfer": {
      "prefix": "TRF",
      "format": "TRF-{yyyy}-{seq:5}",
      "per_branch": false,
      "reserve_on_approval": false
    }
  },
  "inventory_policy_defaults": {
    "costing_method": "WAC",
    "default_track_batch": false,
    "default_track_expiry": false,
    "default_track_serial": false,
    "default_imei_tracking": false,
    "fefo_picking": false,
    "allow_negative_stock": false
  },
  "report_defaults": [
    {
      "report_key": "notes.maturity-calendar",
      "pinned": true,
      "dashboard": true,
      "default_period": "this_month"
    },
    {
      "report_key": "notes.aging",
      "pinned": true,
      "dashboard": false,
      "default_period": "this_month"
    },
    {
      "report_key": "partners.ar_aging",
      "pinned": true,
      "dashboard": true,
      "default_period": "this_month"
    },
    {
      "report_key": "inventory.stock_valuation",
      "pinned": true,
      "dashboard": false,
      "default_period": "custom"
    }
  ],
  "onboarding_steps": [
    {
      "id": "coa_confirm",
      "title": {
        "en": "Confirm chart of accounts (trade receivables, notes receivable)",
        "ar": "تأكيد دليل الحسابات (ذمم التجار، أوراق القبض)"
      },
      "required": true
    },
    {
      "id": "warehouses",
      "title": {
        "en": "Main & branch warehouses",
        "ar": "المستودع الرئيسي ومستودعات الفروع"
      },
      "required": true
    },
    {
      "id": "price_tiers",
      "title": {
        "en": "Price lists with quantity breaks & customer tiers",
        "ar": "قوائم الأسعار مع شرائح الكمية وفئات العملاء"
      },
      "required": true
    },
    {
      "id": "customers_credit",
      "title": {
        "en": "Customers with credit terms, limits & opening balances",
        "ar": "العملاء مع شروط الدفع وحدود الائتمان والأرصدة الافتتاحية"
      },
      "required": true
    },
    {
      "id": "opening_stock",
      "title": {
        "en": "Opening stock via goods receipts",
        "ar": "المخزون الافتتاحي عبر سندات الاستلام"
      },
      "required": true
    },
    {
      "id": "first_cycle",
      "title": {
        "en": "Run quote → bulk order → delivery → credit invoice",
        "ar": "تنفيذ أول دورة: عرض، أمر توريد، تسليم، فاتورة آجل"
      },
      "required": false
    },
    {
      "id": "first_pdc",
      "title": {
        "en": "Receive a first PDC note against an invoice",
        "ar": "استلام أول شيك مؤجل مقابل فاتورة"
      },
      "required": false,
      "feature_key": "notes.received"
    }
  ],
  "capability_prerequisites": {
    "customer_price_tiers": {
      "level": "REQUIRED",
      "feature_keys": [
        "items.price_lists",
        "distribution.customer_tiers"
      ],
      "available_from_phase": "PHASE-017"
    },
    "pdc_notes": {
      "level": "REQUIRED",
      "feature_keys": [
        "notes.received",
        "notes.pdc_calendar"
      ],
      "available_from_phase": "PHASE-027"
    },
    "installment_terms": {
      "level": "OPTIONAL",
      "feature_keys": [
        "installments.plans",
        "installments.late_fees"
      ],
      "available_from_phase": "PHASE-027"
    },
    "barcode_pos": {
      "level": "OPTIONAL",
      "feature_keys": [
        "pos.terminals",
        "pos.sales",
        "pos.receipts"
      ],
      "available_from_phase": "PHASE-016"
    },
    "cashier_shifts": {
      "level": "OPTIONAL",
      "feature_keys": [
        "treasury.cashier_shifts"
      ],
      "available_from_phase": "PHASE-016"
    },
    "imei_tracking": {
      "level": "OPTIONAL",
      "feature_keys": [
        "inventory.serial_tracking"
      ],
      "available_from_phase": "PHASE-010"
    },
    "expiry_tracking_fefo": {
      "level": "OPTIONAL",
      "feature_keys": [
        "inventory.batch_tracking"
      ],
      "available_from_phase": "PHASE-010"
    },
    "free_goods_promo": {
      "level": "OPTIONAL",
      "feature_keys": [
        "sales.discount_management",
        "distribution.free_goods"
      ],
      "available_from_phase": "PHASE-017"
    },
    "commissions": {
      "level": "OPTIONAL",
      "feature_keys": [
        "sales.commissions"
      ],
      "available_from_phase": "PHASE-017"
    },
    "landed_costs": {
      "level": "OPTIONAL",
      "feature_keys": [
        "purchasing.landed_costs"
      ],
      "available_from_phase": "PHASE-011"
    },
    "route_planning": {
      "level": "OPTIONAL",
      "feature_keys": [
        "distribution.routes"
      ],
      "available_from_phase": "PHASE-017"
    },
    "field_collections": {
      "level": "OPTIONAL",
      "feature_keys": [
        "treasury.receipts_disbursements"
      ],
      "available_from_phase": "PHASE-017"
    },
    "shipment_tracking": {
      "level": "OPTIONAL",
      "feature_keys": [
        "distribution.shipment_tracking"
      ],
      "available_from_phase": "PHASE-019"
    }
  }
}
