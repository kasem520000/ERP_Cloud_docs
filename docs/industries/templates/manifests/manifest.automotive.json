{
  "id": "industry.automotive",
  "name": "Automotive & Workshop",
  "name_ar": "قطع الغيار والورش",
  "version": "1.0.0",
  "required_feature_keys": [
    "industry.template_engine",
    "items.barcodes",
    "items.price_lists",
    "inventory.multi_warehouse",
    "inventory.serial_tracking",
    "inventory.reservations",
    "sales.quotations",
    "sales.job_cards",
    "sales.reps",
    "treasury.cashier_shifts"
  ],
  "default_modules_enabled": [
    "accounting",
    "partners",
    "items",
    "inventory",
    "sales",
    "purchasing",
    "treasury",
    "tax",
    "reporting",
    "configuration"
  ],
  "terminology_overrides": {
    "svc.job_card": {
      "en": "Job card",
      "ar": "بطاقة عمل"
    },
    "fleet.vehicle": {
      "en": "Vehicle",
      "ar": "المركبة"
    },
    "svc.labor": {
      "en": "Labor",
      "ar": "أجور العمل"
    },
    "vehicle.make": {
      "en": "Make",
      "ar": "الصانع"
    },
    "vehicle.model": {
      "en": "Model",
      "ar": "الطراز"
    },
    "vehicle.chassis_no": {
      "en": "Chassis number (VIN)",
      "ar": "رقم الهيكل"
    },
    "vehicle.odometer": {
      "en": "Odometer",
      "ar": "عداد المسافة"
    },
    "svc.diagnosis": {
      "en": "Diagnosis",
      "ar": "الفحص والتشخيص"
    },
    "svc.technician": {
      "en": "Technician",
      "ar": "الفني"
    },
    "svc.service_history": {
      "en": "Service history",
      "ar": "سجل الصيانة"
    },
    "part.warranty": {
      "en": "Parts warranty",
      "ar": "ضمان قطع الغيار"
    }
  },
  "navigation_manifest": {
    "groups": [
      {
        "id": "workshop",
        "label": {
          "en": "Workshop",
          "ar": "الورشة"
        },
        "order": 1,
        "items": [
          {
            "id": "job_cards",
            "label": {
              "en": "Job cards",
              "ar": "بطاقات العمل"
            },
            "target": "sales.job_cards"
          },
          {
            "id": "vehicles",
            "label": {
              "en": "Vehicles",
              "ar": "المركبات"
            },
            "target": "partners.vehicles"
          },
          {
            "id": "quotes",
            "label": {
              "en": "Diagnosis quotes",
              "ar": "عروض التشخيص"
            },
            "target": "sales.quotations"
          }
        ]
      },
      {
        "id": "parts",
        "label": {
          "en": "Parts",
          "ar": "قطع الغيار"
        },
        "order": 2,
        "items": [
          {
            "id": "parts_stock",
            "label": {
              "en": "Parts stock",
              "ar": "مخزون القطع"
            },
            "target": "inventory.on_hand"
          },
          {
            "id": "purchasing",
            "label": {
              "en": "Parts purchasing",
              "ar": "شراء القطع"
            },
            "target": "purchasing.orders"
          },
          {
            "id": "counter",
            "label": {
              "en": "Counter sale",
              "ar": "بيع الكاونتر"
            },
            "target": "pos.counter",
            "feature_key": "pos.sales"
          }
        ]
      }
    ]
  },
  "workflow_policies": {
    "job_card_parts_issue_mode": "reserve",
    "job_card_labor_rate_source": "price_list",
    "quotation_validity_days": 7,
    "invoice_approval_required_over": 0,
    "warranty_credit_note_requires_original_invoice": true,
    "shift_variance_approval_required": true
  },
  "document_numbering_defaults": {
    "job_card": {
      "prefix": "JC",
      "format": "JC-{yyyy}-{seq:5}",
      "per_branch": true,
      "reserve_on_approval": false
    },
    "quotation": {
      "prefix": "QT",
      "format": "QT-{yyyy}-{seq:5}",
      "per_branch": false,
      "reserve_on_approval": false
    },
    "sales_invoice": {
      "prefix": "INV",
      "format": "INV-{yyyy}-{seq:6}",
      "per_branch": false,
      "reserve_on_approval": false
    },
    "credit_note": {
      "prefix": "CN",
      "format": "CN-{yyyy}-{seq:5}",
      "per_branch": false,
      "reserve_on_approval": false
    },
    "purchase_order": {
      "prefix": "PO",
      "format": "PO-{yyyy}-{seq:5}",
      "per_branch": false,
      "reserve_on_approval": true
    }
  },
  "inventory_policy_defaults": {
    "costing_method": "WAC",
    "default_track_batch": false,
    "default_track_expiry": false,
    "default_track_serial": false,
    "default_imei_tracking": false,
    "fefo_picking": false,
    "allow_negative_stock": false
  },
  "report_defaults": [
    {
      "report_key": "automotive.job_card_profitability",
      "pinned": true,
      "dashboard": true,
      "default_period": "this_month"
    },
    {
      "report_key": "automotive.vehicle_service_history",
      "pinned": true,
      "dashboard": false,
      "default_period": "custom"
    },
    {
      "report_key": "inventory.stock_valuation",
      "pinned": true,
      "dashboard": false,
      "default_period": "custom"
    },
    {
      "report_key": "partners.ar_aging",
      "pinned": true,
      "dashboard": false,
      "default_period": "this_month"
    }
  ],
  "onboarding_steps": [
    {
      "id": "branch_bays",
      "title": {
        "en": "Branch, workshop & bays",
        "ar": "الفرع والورشة والمواقف"
      },
      "required": true
    },
    {
      "id": "coa_confirm",
      "title": {
        "en": "Confirm chart of accounts (parts vs labor revenue)",
        "ar": "تأكيد دليل الحسابات (إيراد القطع مقابل أجور العمل)"
      },
      "required": true
    },
    {
      "id": "labor_rates",
      "title": {
        "en": "Labor rate price lists",
        "ar": "قوائم أسعار أجور العمل"
      },
      "required": true
    },
    {
      "id": "parts_catalog",
      "title": {
        "en": "Parts catalog & suppliers",
        "ar": "كتالوج القطع والموردون"
      },
      "required": true
    },
    {
      "id": "opening_stock",
      "title": {
        "en": "Opening parts stock",
        "ar": "رصيد القطع الافتتاحي"
      },
      "required": true
    },
    {
      "id": "vehicles",
      "title": {
        "en": "Import customer vehicles",
        "ar": "استيراد مركبات العملاء"
      },
      "required": false
    },
    {
      "id": "first_job",
      "title": {
        "en": "Run a first job card end-to-end",
        "ar": "تنفيذ أول بطاقة عمل كاملة"
      },
      "required": false
    }
  ],
  "capability_prerequisites": {
    "job_cards": {
      "level": "REQUIRED",
      "feature_keys": [
        "sales.job_cards"
      ],
      "available_from_phase": "PHASE-017"
    },
    "commissions": {
      "level": "OPTIONAL",
      "feature_keys": [
        "sales.commissions"
      ],
      "available_from_phase": "PHASE-017"
    },
    "barcode_pos": {
      "level": "OPTIONAL",
      "feature_keys": [
        "pos.terminals",
        "pos.sales",
        "pos.receipts"
      ],
      "available_from_phase": "PHASE-016"
    },
    "service_contracts": {
      "level": "OPTIONAL",
      "feature_keys": [
        "crm.service_contracts"
      ],
      "available_from_phase": "PHASE-019"
    },
    "landed_costs": {
      "level": "OPTIONAL",
      "feature_keys": [
        "purchasing.landed_costs"
      ],
      "available_from_phase": "PHASE-011"
    },
    "qc_inspections": {
      "level": "OPTIONAL",
      "feature_keys": [
        "manufacturing.qc"
      ],
      "available_from_phase": "PHASE-018"
    }
  }
}
