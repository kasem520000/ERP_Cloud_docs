{
  "id": "industry.electronics",
  "name": "Mobile & Electronics",
  "name_ar": "الجوالات والإلكترونيات",
  "version": "1.0.0",
  "required_feature_keys": [
    "industry.template_engine",
    "items.barcodes",
    "items.price_lists",
    "inventory.serial_tracking",
    "pos.terminals",
    "pos.sales",
    "pos.offline_queue",
    "pos.receipts",
    "crm.service_orders",
    "sales.invoices",
    "treasury.cashier_shifts"
  ],
  "default_modules_enabled": [
    "accounting",
    "partners",
    "items",
    "inventory",
    "sales",
    "purchasing",
    "treasury",
    "tax",
    "reporting",
    "pos",
    "crm",
    "configuration"
  ],
  "terminology_overrides": {
    "pos.sale": {
      "en": "Retail sale",
      "ar": "بيع بالتجزئة"
    },
    "svc.repair_card": {
      "en": "Repair card",
      "ar": "بطاقة صيانة"
    },
    "svc.repair": {
      "en": "Repair",
      "ar": "الصيانة / الإصلاح"
    },
    "item.imei": {
      "en": "IMEI",
      "ar": "الرقم التسلسلي (IMEI)"
    },
    "device.checkin": {
      "en": "Device check-in",
      "ar": "استلام الجهاز"
    },
    "tradein.purchase": {
      "en": "Trade-in purchase",
      "ar": "شراء جهاز مستعمل"
    },
    "part.accessory": {
      "en": "Accessory",
      "ar": "ملحق"
    },
    "part.spare": {
      "en": "Spare part",
      "ar": "قطعة غيار"
    },
    "svc.warranty": {
      "en": "Warranty claim",
      "ar": "بطارية الضمان / مطالبة الضمان"
    },
    "svc.labor": {
      "en": "Labor",
      "ar": "أجور الصيانة"
    }
  },
  "navigation_manifest": {
    "groups": [
      {
        "id": "counter",
        "label": {
          "en": "Counter",
          "ar": "الكاونتر"
        },
        "order": 1,
        "items": [
          {
            "id": "pos",
            "label": {
              "en": "Point of sale",
              "ar": "نقطة البيع"
            },
            "target": "pos.counter",
            "feature_key": "pos.sales"
          },
          {
            "id": "imei",
            "label": {
              "en": "IMEI register",
              "ar": "سجل الأجهزة"
            },
            "target": "inventory.imei",
            "feature_key": "inventory.serial_tracking"
          },
          {
            "id": "tradein",
            "label": {
              "en": "Trade-in purchases",
              "ar": "شراء الأجهزة المستعملة"
            },
            "target": "purchasing.tradein"
          }
        ]
      },
      {
        "id": "service",
        "label": {
          "en": "Repair",
          "ar": "الصيانة"
        },
        "order": 2,
        "items": [
          {
            "id": "repair_cards",
            "label": {
              "en": "Repair cards",
              "ar": "بطاقات الصيانة"
            },
            "target": "crm.service_orders",
            "feature_key": "crm.service_orders"
          },
          {
            "id": "returns",
            "label": {
              "en": "Returns & exchanges",
              "ar": "المرتجعات والاستبدال"
            },
            "target": "sales.credit_notes"
          },
          {
            "id": "receipts",
            "label": {
              "en": "Receipts",
              "ar": "سندات القبض"
            },
            "target": "treasury.receipts"
          }
        ]
      }
    ]
  },
  "workflow_policies": {
    "cash_sales_autopost": true,
    "imei_capture_required_flagged_items": true,
    "repair_parts_issue_mode": "reserve",
    "repair_card_labor_rate_source": "price_list",
    "tradein_purchase_at_branch": true,
    "warranty_credit_note_requires_original_invoice": true,
    "shift_variance_approval_required": true
  },
  "document_numbering_defaults": {
    "sales_invoice": {
      "prefix": "INV",
      "format": "INV-{yyyy}-{seq:6}",
      "per_branch": false,
      "reserve_on_approval": false
    },
    "pos_sale": {
      "prefix": "POS",
      "format": "POS-{branch}-{yy}{MM}-{seq:5}",
      "per_branch": true,
      "reserve_on_approval": false
    },
    "job_card": {
      "prefix": "RC",
      "format": "RC-{yyyy}-{seq:5}",
      "per_branch": true,
      "reserve_on_approval": false
    },
    "credit_note": {
      "prefix": "CN",
      "format": "CN-{yyyy}-{seq:5}",
      "per_branch": false,
      "reserve_on_approval": false
    },
    "goods_receipt": {
      "prefix": "GRN",
      "format": "GRN-{yyyy}-{seq:5}",
      "per_branch": false,
      "reserve_on_approval": false
    }
  },
  "inventory_policy_defaults": {
    "costing_method": "WAC",
    "default_track_batch": false,
    "default_track_expiry": false,
    "default_track_serial": true,
    "default_imei_tracking": true,
    "fefo_picking": false,
    "allow_negative_stock": false
  },
  "report_defaults": [
    {
      "report_key": "retail.imei_register",
      "pinned": true,
      "dashboard": true,
      "default_period": "this_month"
    },
    {
      "report_key": "pos.sales_by_terminal",
      "pinned": true,
      "dashboard": true,
      "default_period": "today"
    },
    {
      "report_key": "pos.sales_by_hour",
      "pinned": true,
      "dashboard": false,
      "default_period": "this_week"
    },
    {
      "report_key": "inventory.stock_valuation",
      "pinned": true,
      "dashboard": false,
      "default_period": "custom"
    }
  ],
  "onboarding_steps": [
    {
      "id": "counter_branch",
      "title": {
        "en": "Create branch, stockroom & terminals",
        "ar": "إنشاء الفرع والمستودع وأجهزة نقطة البيع"
      },
      "required": true
    },
    {
      "id": "coa_confirm",
      "title": {
        "en": "Confirm chart of accounts (device vs service vs used-goods)",
        "ar": "تأكيد دليل الحسابات (الأجهزة، الصيانة، الأجهزة المستعملة)"
      },
      "required": true
    },
    {
      "id": "imei_categories",
      "title": {
        "en": "Item categories with IMEI flags",
        "ar": "تصنيفات الأصناف مع خيار تسجيل IMEI"
      },
      "required": true
    },
    {
      "id": "labor_rates",
      "title": {
        "en": "Repair labor rate lists",
        "ar": "قوائم أسعار أجور الصيانة"
      },
      "required": true
    },
    {
      "id": "opening_stock",
      "title": {
        "en": "Opening stock with IMEI capture",
        "ar": "المخزون الافتتاحي مع تسجيل الأجهزة"
      },
      "required": true
    },
    {
      "id": "first_repair",
      "title": {
        "en": "Run a first repair card end-to-end",
        "ar": "تنفيذ أول بطاقة صيانة كاملة"
      },
      "required": false,
      "feature_key": "crm.service_orders"
    },
    {
      "id": "first_shift",
      "title": {
        "en": "Open first shift and sell",
        "ar": "افتتاح أول وردية وإجراء أول عملية بيع"
      },
      "required": false,
      "feature_key": "pos.sales"
    }
  ],
  "capability_prerequisites": {
    "imei_tracking": {
      "level": "REQUIRED",
      "feature_keys": [
        "inventory.serial_tracking"
      ],
      "available_from_phase": "PHASE-010"
    },
    "job_cards": {
      "level": "REQUIRED",
      "feature_keys": [
        "crm.service_orders"
      ],
      "available_from_phase": "PHASE-019"
    },
    "barcode_pos": {
      "level": "REQUIRED",
      "feature_keys": [
        "pos.terminals",
        "pos.sales",
        "pos.offline_queue",
        "pos.receipts"
      ],
      "available_from_phase": "PHASE-016"
    },
    "cashier_shifts": {
      "level": "REQUIRED",
      "feature_keys": [
        "treasury.cashier_shifts"
      ],
      "available_from_phase": "PHASE-016"
    },
    "composite_kits": {
      "level": "OPTIONAL",
      "feature_keys": [
        "items.composite_products"
      ],
      "available_from_phase": "PHASE-016"
    },
    "customer_price_tiers": {
      "level": "OPTIONAL",
      "feature_keys": [
        "distribution.customer_tiers"
      ],
      "available_from_phase": "PHASE-017"
    },
    "free_goods_promo": {
      "level": "OPTIONAL",
      "feature_keys": [
        "sales.discount_management",
        "distribution.free_goods"
      ],
      "available_from_phase": "PHASE-017"
    },
    "commissions": {
      "level": "OPTIONAL",
      "feature_keys": [
        "sales.commissions"
      ],
      "available_from_phase": "PHASE-017"
    },
    "landed_costs": {
      "level": "OPTIONAL",
      "feature_keys": [
        "purchasing.landed_costs"
      ],
      "available_from_phase": "PHASE-011"
    },
    "service_contracts": {
      "level": "OPTIONAL",
      "feature_keys": [
        "crm.service_contracts"
      ],
      "available_from_phase": "PHASE-019"
    },
    "pdc_notes": {
      "level": "OPTIONAL",
      "feature_keys": [
        "notes.received"
      ],
      "available_from_phase": "PHASE-027"
    },
    "installment_terms": {
      "level": "OPTIONAL",
      "feature_keys": [
        "installments.plans"
      ],
      "available_from_phase": "PHASE-027"
    }
  }
}
