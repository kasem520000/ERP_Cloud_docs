{
  "id": "industry.grocery",
  "name": "Grocery & Supermarket",
  "name_ar": "البقالات والسوبرماركت",
  "version": "1.0.0",
  "required_feature_keys": [
    "industry.template_engine",
    "items.barcodes",
    "items.price_lists",
    "distribution.customer_tiers",
    "inventory.multi_warehouse",
    "inventory.batch_tracking",
    "inventory.stock_counts",
    "pos.terminals",
    "pos.sales",
    "pos.offline_queue",
    "pos.barcode_scanning",
    "pos.receipts",
    "treasury.cashier_shifts"
  ],
  "default_modules_enabled": [
    "accounting",
    "partners",
    "items",
    "inventory",
    "sales",
    "purchasing",
    "treasury",
    "tax",
    "reporting",
    "pos",
    "configuration"
  ],
  "terminology_overrides": {
    "item.scale_item": {
      "en": "Scale item",
      "ar": "صنف الميزان"
    },
    "batch.expiry": {
      "en": "Expiry date",
      "ar": "تاريخ الانتهاء"
    },
    "inventory.fefo": {
      "en": "FEFO (nearest expiry first)",
      "ar": "الأقرب انتهاءً يصدر أولاً"
    },
    "inventory.markdown": {
      "en": "Near-expiry markdown",
      "ar": "تخفيض قرب الانتهاء"
    },
    "inventory.writeoff": {
      "en": "Write-off",
      "ar": "الإعدام"
    },
    "item.shelf_life": {
      "en": "Shelf life",
      "ar": "مدة الصلاحية"
    },
    "purchasing.reorder": {
      "en": "Reorder level",
      "ar": "حد إعادة الطلب"
    }
  },
  "navigation_manifest": {
    "groups": [
      {
        "id": "selling",
        "label": {
          "en": "Selling",
          "ar": "البيع"
        },
        "order": 1,
        "items": [
          {
            "id": "pos",
            "label": {
              "en": "Point of sale",
              "ar": "نقطة البيع"
            },
            "target": "pos.counter",
            "feature_key": "pos.sales"
          },
          {
            "id": "tiers",
            "label": {
              "en": "Customer price tiers",
              "ar": "فئات أسعار العملاء"
            },
            "target": "items.tiers"
          }
        ]
      },
      {
        "id": "expiry",
        "label": {
          "en": "Expiry control",
          "ar": "الرقابة على الصلاحية"
        },
        "order": 2,
        "items": [
          {
            "id": "expiry_list",
            "label": {
              "en": "Expiry list",
              "ar": "قائمة الصلاحيات"
            },
            "target": "inventory.expiry_list"
          },
          {
            "id": "writeoff",
            "label": {
              "en": "Write-off register",
              "ar": "سجل الإعدام"
            },
            "target": "inventory.writeoff"
          },
          {
            "id": "counts",
            "label": {
              "en": "Stock counts",
              "ar": "جرد المخزون"
            },
            "target": "inventory.counts"
          }
        ]
      }
    ]
  },
  "workflow_policies": {
    "cash_sales_autopost": true,
    "expiry_writeoff_requires_approval": true,
    "markdown_requires_approval": false,
    "batch_expiry_capture_required_on_grn": true,
    "scale_item_weighed_lines": true,
    "shift_variance_approval_required": true
  },
  "document_numbering_defaults": {
    "pos_sale": {
      "prefix": "POS",
      "format": "POS-{branch}-{yy}{MM}-{seq:5}",
      "per_branch": true,
      "reserve_on_approval": false
    },
    "sales_invoice": {
      "prefix": "INV",
      "format": "INV-{yyyy}-{seq:6}",
      "per_branch": false,
      "reserve_on_approval": false
    },
    "goods_receipt": {
      "prefix": "GRN",
      "format": "GRN-{yyyy}-{seq:6}",
      "per_branch": false,
      "reserve_on_approval": false
    },
    "credit_note": {
      "prefix": "CN",
      "format": "CN-{yyyy}-{seq:5}",
      "per_branch": false,
      "reserve_on_approval": false
    }
  },
  "inventory_policy_defaults": {
    "costing_method": "WAC",
    "default_track_batch": true,
    "default_track_expiry": true,
    "default_track_serial": false,
    "default_imei_tracking": false,
    "fefo_picking": true,
    "allow_negative_stock": false
  },
  "report_defaults": [
    {
      "report_key": "inventory.expiry_list",
      "pinned": true,
      "dashboard": true,
      "default_period": "this_week"
    },
    {
      "report_key": "grocery.expiry_writeoff",
      "pinned": true,
      "dashboard": true,
      "default_period": "this_month"
    },
    {
      "report_key": "pos.sales_by_hour",
      "pinned": true,
      "dashboard": true,
      "default_period": "this_week"
    },
    {
      "report_key": "inventory.stock_valuation",
      "pinned": true,
      "dashboard": false,
      "default_period": "custom"
    }
  ],
  "onboarding_steps": [
    {
      "id": "branch_warehouse",
      "title": {
        "en": "Create branch, shop floor and backroom",
        "ar": "إنشاء الفرع وصالة البيع والمستودع الخلفي"
      },
      "required": true
    },
    {
      "id": "coa_confirm",
      "title": {
        "en": "Confirm chart of accounts",
        "ar": "تأكيد دليل الحسابات"
      },
      "required": true
    },
    {
      "id": "categories",
      "title": {
        "en": "Food categories with batch/expiry defaults",
        "ar": "تصنيفات الأغذية مع خيارات الدفعة والصلاحية"
      },
      "required": true
    },
    {
      "id": "scale_items",
      "title": {
        "en": "Set up scale items",
        "ar": "تهيئة أصناف الميزان"
      },
      "required": false,
      "feature_key": "pos.barcode_scanning"
    },
    {
      "id": "suppliers",
      "title": {
        "en": "Suppliers & opening stock with batches",
        "ar": "الموردون والمخزون الافتتاحي مع الدفعات"
      },
      "required": true
    },
    {
      "id": "tiers",
      "title": {
        "en": "Price tiers (retail / wholesale)",
        "ar": "فئات الأسعار (تجزئة / جملة)"
      },
      "required": false
    },
    {
      "id": "terminals",
      "title": {
        "en": "Set up POS terminals & scales",
        "ar": "تهيئة أجهزة نقطة البيع والموازين"
      },
      "required": true,
      "feature_key": "pos.terminals"
    },
    {
      "id": "first_count",
      "title": {
        "en": "Baseline count for expiry-sensitive stock",
        "ar": "جرد أساسي للأصناف الحساسة للصلاحية"
      },
      "required": true
    }
  ],
  "capability_prerequisites": {
    "barcode_pos": {
      "level": "REQUIRED",
      "feature_keys": [
        "pos.terminals",
        "pos.sales",
        "pos.offline_queue",
        "pos.receipts"
      ],
      "available_from_phase": "PHASE-016"
    },
    "scale_barcodes": {
      "level": "REQUIRED",
      "feature_keys": [
        "pos.barcode_scanning"
      ],
      "available_from_phase": "PHASE-016"
    },
    "expiry_tracking_fefo": {
      "level": "REQUIRED",
      "feature_keys": [
        "inventory.batch_tracking"
      ],
      "available_from_phase": "PHASE-010"
    },
    "customer_price_tiers": {
      "level": "REQUIRED",
      "feature_keys": [
        "distribution.customer_tiers"
      ],
      "available_from_phase": "PHASE-017"
    },
    "cashier_shifts": {
      "level": "REQUIRED",
      "feature_keys": [
        "treasury.cashier_shifts"
      ],
      "available_from_phase": "PHASE-016"
    },
    "free_goods_promo": {
      "level": "OPTIONAL",
      "feature_keys": [
        "sales.discount_management",
        "distribution.free_goods"
      ],
      "available_from_phase": "PHASE-017"
    },
    "composite_kits": {
      "level": "OPTIONAL",
      "feature_keys": [
        "items.composite_products"
      ],
      "available_from_phase": "PHASE-016"
    },
    "qc_inspections": {
      "level": "OPTIONAL",
      "feature_keys": [
        "manufacturing.qc"
      ],
      "available_from_phase": "PHASE-018"
    }
  }
}
