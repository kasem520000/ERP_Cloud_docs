{
  "id": "industry.restaurant",
  "name": "Restaurant & Café",
  "name_ar": "المطاعم والمقاهي",
  "version": "1.0.0",
  "required_feature_keys": [
    "industry.template_engine",
    "items.barcodes",
    "items.price_lists",
    "inventory.multi_warehouse",
    "inventory.batch_tracking",
    "items.composite_products",
    "inventory.stock_counts",
    "pos.terminals",
    "pos.sales",
    "pos.offline_queue",
    "pos.table_service",
    "pos.receipts",
    "treasury.cashier_shifts"
  ],
  "default_modules_enabled": [
    "accounting",
    "partners",
    "items",
    "inventory",
    "sales",
    "purchasing",
    "treasury",
    "tax",
    "reporting",
    "pos",
    "configuration"
  ],
  "terminology_overrides": {
    "pos.table": {
      "en": "Table",
      "ar": "طاولة"
    },
    "pos.order": {
      "en": "Order",
      "ar": "طلب"
    },
    "pos.kitchen": {
      "en": "Kitchen",
      "ar": "المطبخ"
    },
    "pos.order_type": {
      "en": "Order type",
      "ar": "نوع الطلب"
    },
    "pos.dine_in": {
      "en": "Dine-in",
      "ar": "داخل المطعم"
    },
    "pos.takeaway": {
      "en": "Takeaway",
      "ar": "سفري"
    },
    "pos.delivery": {
      "en": "Delivery",
      "ar": "توصيل"
    },
    "pos.check": {
      "en": "Guest check",
      "ar": "الحساب"
    },
    "menu.combo": {
      "en": "Combo / set meal",
      "ar": "وجبة"
    },
    "menu.modifier": {
      "en": "Modifier (extra)",
      "ar": "إضافة"
    },
    "pos.z_close": {
      "en": "Z close (day end)",
      "ar": "الإغلاق اليومي"
    },
    "billing.service_charge": {
      "en": "Service charge",
      "ar": "رسوم الخدمة"
    }
  },
  "navigation_manifest": {
    "groups": [
      {
        "id": "floor",
        "label": {
          "en": "Floor",
          "ar": "صالة المطعم"
        },
        "order": 1,
        "items": [
          {
            "id": "tables",
            "label": {
              "en": "Tables",
              "ar": "الطاولات"
            },
            "target": "pos.floor",
            "feature_key": "pos.table_service"
          },
          {
            "id": "quick_sale",
            "label": {
              "en": "Quick sale",
              "ar": "بيع سريع"
            },
            "target": "pos.counter",
            "feature_key": "pos.sales"
          },
          {
            "id": "kitchen",
            "label": {
              "en": "Kitchen tickets",
              "ar": "تذاكر المطبخ"
            },
            "target": "pos.kitchen",
            "feature_key": "pos.kitchen_display"
          }
        ]
      },
      {
        "id": "day",
        "label": {
          "en": "Daily close",
          "ar": "الإغلاق اليومي"
        },
        "order": 2,
        "items": [
          {
            "id": "shifts",
            "label": {
              "en": "Shifts",
              "ar": "الورديات"
            },
            "target": "treasury.shifts"
          },
          {
            "id": "z_close",
            "label": {
              "en": "Z close report",
              "ar": "تقرير الإغلاق اليومي"
            },
            "target": "pos.z_close"
          }
        ]
      }
    ]
  },
  "workflow_policies": {
    "cash_sales_autopost": true,
    "default_pos_order_type": "dine_in",
    "unpaid_table_holds_no_ledger": true,
    "combo_explosion_at_posting": true,
    "service_charge_default_rate": 0,
    "shift_variance_approval_required": true,
    "daily_waste_count_recommended": true
  },
  "document_numbering_defaults": {
    "pos_sale": {
      "prefix": "RC",
      "format": "RC-{branch}-{yy}{MM}-{seq:5}",
      "per_branch": true,
      "reserve_on_approval": false
    },
    "purchase_order": {
      "prefix": "PO",
      "format": "PO-{yyyy}-{seq:5}",
      "per_branch": false,
      "reserve_on_approval": true
    },
    "goods_receipt": {
      "prefix": "GRN",
      "format": "GRN-{yyyy}-{seq:5}",
      "per_branch": false,
      "reserve_on_approval": false
    },
    "stock_adjustment": {
      "prefix": "ADJ",
      "format": "ADJ-{yyyy}-{seq:5}",
      "per_branch": false,
      "reserve_on_approval": false
    }
  },
  "inventory_policy_defaults": {
    "costing_method": "WAC",
    "default_track_batch": true,
    "default_track_expiry": true,
    "default_track_serial": false,
    "default_imei_tracking": false,
    "fefo_picking": true,
    "allow_negative_stock": false
  },
  "report_defaults": [
    {
      "report_key": "restaurant.sales_by_table",
      "pinned": true,
      "dashboard": true,
      "default_period": "this_week"
    },
    {
      "report_key": "restaurant.order_type_mix",
      "pinned": true,
      "dashboard": true,
      "default_period": "this_week"
    },
    {
      "report_key": "pos.sales_by_hour",
      "pinned": true,
      "dashboard": true,
      "default_period": "this_week"
    },
    {
      "report_key": "treasury.shift_cash_reconciliation",
      "pinned": true,
      "dashboard": false,
      "default_period": "today"
    },
    {
      "report_key": "inventory.expiry_list",
      "pinned": true,
      "dashboard": true,
      "default_period": "this_week"
    }
  ],
  "onboarding_steps": [
    {
      "id": "branch_floors",
      "title": {
        "en": "Branch, kitchen & floor layout",
        "ar": "الفرع والمطبخ وتخطيط الصالة"
      },
      "required": true
    },
    {
      "id": "coa_confirm",
      "title": {
        "en": "Confirm chart of accounts",
        "ar": "تأكيد دليل الحسابات"
      },
      "required": true
    },
    {
      "id": "menu",
      "title": {
        "en": "Build menu (items, combos, modifiers)",
        "ar": "بناء قائمة الطعام (أصناف، وجبات، إضافات)"
      },
      "required": true
    },
    {
      "id": "ingredients",
      "title": {
        "en": "Ingredient stock with expiry",
        "ar": "مخزون المكونات مع الصلاحية"
      },
      "required": true
    },
    {
      "id": "suppliers",
      "title": {
        "en": "Suppliers & opening stock",
        "ar": "الموردون والمخزون الافتتاحي"
      },
      "required": true
    },
    {
      "id": "terminals",
      "title": {
        "en": "Terminals & floor plan",
        "ar": "تهيئة الأجهزة وخريطة الطاولات"
      },
      "required": true,
      "feature_key": "pos.table_service"
    },
    {
      "id": "first_day",
      "title": {
        "en": "Run first service day and Z close",
        "ar": "تشغيل أول يوم خدمة والإغلاق اليومي"
      },
      "required": false,
      "feature_key": "pos.sales"
    }
  ],
  "capability_prerequisites": {
    "table_service": {
      "level": "REQUIRED",
      "feature_keys": [
        "pos.table_service"
      ],
      "available_from_phase": "PHASE-016"
    },
    "barcode_pos": {
      "level": "REQUIRED",
      "feature_keys": [
        "pos.terminals",
        "pos.sales",
        "pos.offline_queue",
        "pos.receipts"
      ],
      "available_from_phase": "PHASE-016"
    },
    "cashier_shifts": {
      "level": "REQUIRED",
      "feature_keys": [
        "treasury.cashier_shifts"
      ],
      "available_from_phase": "PHASE-016"
    },
    "composite_kits": {
      "level": "REQUIRED",
      "feature_keys": [
        "items.composite_products"
      ],
      "available_from_phase": "PHASE-016"
    },
    "expiry_tracking_fefo": {
      "level": "REQUIRED",
      "feature_keys": [
        "inventory.batch_tracking"
      ],
      "available_from_phase": "PHASE-010"
    },
    "kitchen_display": {
      "level": "OPTIONAL",
      "feature_keys": [
        "pos.kitchen_display"
      ],
      "available_from_phase": "PHASE-016"
    },
    "bom_production": {
      "level": "OPTIONAL",
      "feature_keys": [
        "manufacturing.bom",
        "manufacturing.production_orders"
      ],
      "available_from_phase": "PHASE-018"
    },
    "free_goods_promo": {
      "level": "OPTIONAL",
      "feature_keys": [
        "distribution.free_goods"
      ],
      "available_from_phase": "PHASE-017"
    }
  }
}
