{
  "name": "@erp/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS modular monolith (ADR-0001/0003). PHASE-001 skeleton: bootstrap + /health/live.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:migrate": "drizzle-kit migrate && tsx ../../scripts/db-dev-credentials.ts",
    "db:generate": "drizzle-kit generate",
    "dev:worker": "WORKER_MODE=1 tsx watch src/main.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@erp/domain-core": "workspace:^",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@opentelemetry/api": "^1.9.0",
    "argon2": "0.45.1",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "pg-boss": "10.4.2",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@erp/config": "workspace:*",
    "@nestjs/testing": "^11.1.6",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/argon2": "^0.15.4",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "16.14.0-beta.17",
    "s3rver": "^3.7.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
