{
  "name": "@erp/api",
  "version": "0.1.0",
  "private": true,
  "description": "ERP API — NestJS modular monolith skeleton (PHASE-001)",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch dist/main.js",
    "start": "node dist/main.js",
    "dev:worker": "WORKER_MODE=1 node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:integration": "echo \"no integration tests in PHASE-001 (PHASE-002 adds Testcontainers)\"",
    "db:migrate": "tsx src/infra/db/migrate.ts",
    "db:seed": "echo \"no seeds until PHASE-002\"",
    "db:generate": "drizzle-kit generate",
    "db:studio": "echo \"drizzle studio not yet (PHASE-002)\"",
    "db:check-rls": "tsx scripts/check-rls.ts",
    "db:check-catalog": "tsx scripts/check-catalog-drift.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-presigned-post": "^3.600.0",
    "@erp/contracts": "workspace:*",
    "@erp/domain-core": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/sdk-node": "^0.53.0",
    "drizzle-orm": "^0.33.0",
    "pg": "^8.11.5",
    "pg-boss": "^10.1.2",
    "pino": "^9.4.0",
    "pino-http": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.24.2",
    "pino-pretty": "^11.2.0",
    "testcontainers": "^10.13.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  }
}