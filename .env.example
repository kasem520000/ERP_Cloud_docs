# ERP Platform — .env.example (PHASE-001 foundation)
# Copy to .env and adjust: cp .env.example .env
# Never commit .env — gitleaks will fail the build.

# Database — Compose dev instance (erp_dev)
DATABASE_URL=postgresql://erp_app:erp_app@localhost:5432/erp_dev
MIGRATE_DATABASE_URL=postgresql://erp_migrate:erp_migrate@localhost:5432/erp_dev
POSTGRES_USER=erp_dev
POSTGRES_PASSWORD=erp_dev
POSTGRES_DB=erp_dev

# Session / auth (PHASE-003+)
SESSION_SECRET=dev-session-secret-change-me-32-chars-min

# Object storage — MinIO (compose)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=erp-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Mail — Mailpit (compose)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=ERP Dev <dev@localhost.test>

# App URLs
PUBLIC_WEB_URL=http://localhost:3000
API_PORT=3001
WEB_PORT=3000

# Runtime
LOG_LEVEL=debug
WORKER_MODE=0
NODE_ENV=development

# Dev seed (local only — must be UNSET in staging/prod)
DEV_SEED_ADMIN_EMAIL=admin@erp-dev.test
DEV_SEED_ADMIN_PASSWORD=admin123

# Observability (PHASE-002+)
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
