# PHASE-001 development environment template.
# Copy to .env for local use — never commit real secrets (gitleaks runs in CI).

# App connection (non-owner role erp_app is created by migration 0001 in PHASE-002)
DATABASE_URL=postgres://erp_app:erp_app@localhost:5432/erp

# Object storage — minio local stand-in (files module, PHASE-002+)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=erp-files

# Identity secret envelope (PHASE-003: TOTP-secret encryption + reset-token
# HMAC derivation). 32 bytes, base64. Dev default below is a LOCAL-ONLY
# placeholder: production sets it out-of-band (SECRETS_MANAGEMENT); unset in
# development/test, the API derives the documented local dev key.
# Generate: openssl rand -base64 32
# IDENTITY_SECRET_KEY=
# IDENTITY_SECRET_KEY_ID=v1

# Outbound mail — mailpit local sink (notifications module, PHASE-003).
# Unset SMTP_HOST disables sending with a warning (documented dev shape).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@erp.local
# SMTP_USER=
# SMTP_PASS=

# Public origin of the web/BFF surface — links inside emails (PHASE-003)
WEB_BASE_URL=http://localhost:3000

# Worker entrypoint flag (PHASE-002+); 0 = web/api process
WORKER_MODE=0

# Logging level (pino)
LOG_LEVEL=debug

# HTTP port of the API app in development
PORT=3001
