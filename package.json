{
  "name": "erp-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Universal Business ERP Platform — modular monolith (NestJS) + Next.js + shared packages",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "type": "commonjs",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "docs:validate": "python3 scripts/validate-docs.py",
    "prepare": "husky install || true"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "dependency-cruiser": "^16.8.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-boundaries": "^4.2.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.0"
  },
  "pnpm": {
    "overrides": {}
  }
}
